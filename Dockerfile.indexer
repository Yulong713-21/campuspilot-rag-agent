FROM python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app/src

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --upgrade pip \
    && python -m pip install \
        --index-url https://download.pytorch.org/whl/cpu \
        torch==2.7.0

COPY requirements-indexer.txt ./
RUN python -m pip install -r requirements-indexer.txt

COPY src ./src
COPY scripts/build_handbook_vector_index.py scripts/search_handbook_hybrid.py ./scripts/

ENTRYPOINT ["python", "scripts/build_handbook_vector_index.py"]
