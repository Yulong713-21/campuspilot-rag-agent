CAMPUSPILOT_DEPLOYMENT_PROFILE=full
CAMPUSPILOT_POSTGRES_PASSWORD=replace-with-a-strong-server-only-secret
DATABASE_URL=postgresql+psycopg://campuspilot:replace-with-the-same-secret@postgres:5432/campuspilot
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX=campuspilot-handbook-v1
CAMPUSPILOT_VECTOR_SEARCH_ENABLED=1
CAMPUSPILOT_MILVUS_URI=/app/data/vector/campuspilot-handbook.db
CAMPUSPILOT_MILVUS_COLLECTION=campuspilot_handbook_v2
CAMPUSPILOT_EMBEDDING_BACKEND=sentence-transformer
CAMPUSPILOT_EMBEDDING_MODEL_PATH=/models/all-MiniLM-L6-v2
CAMPUSPILOT_RERANKER_ENABLED=0
