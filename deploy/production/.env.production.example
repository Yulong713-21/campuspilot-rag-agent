# Public endpoint. Use a real domain after DNS points to the server.
CAMPUSPILOT_DOMAIN=campuspilot.example.com
CAMPUSPILOT_IMAGE=ghcr.io/YOUR_GITHUB_ACCOUNT/campuspilot-agent:latest
CAMPUSPILOT_ENV=production

# OpenAI-compatible cloud model. Keep the real key only on the server.
CAMPUSPILOT_OPENAI_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
CAMPUSPILOT_OPENAI_MODEL=qwen-plus
CAMPUSPILOT_OPENAI_API_KEY=replace-on-server
CAMPUSPILOT_OPENAI_TIMEOUT_SECONDS=60
CAMPUSPILOT_RATE_LIMIT_PER_MINUTE=10
CAMPUSPILOT_MAX_UPLOAD_BYTES=10485760
CAMPUSPILOT_SESSION_TTL_SECONDS=86400

# BM25 + dense vector + RRF + cross-encoder reranking.
CAMPUSPILOT_RETRIEVAL_MODE=hybrid
CAMPUSPILOT_VECTOR_SEARCH_ENABLED=1
CAMPUSPILOT_MILVUS_URI=/app/data/vector/campuspilot-handbook.db
CAMPUSPILOT_MILVUS_COLLECTION=campuspilot_handbook_v2
CAMPUSPILOT_EMBEDDING_BACKEND=sentence-transformer
CAMPUSPILOT_EMBEDDING_MODEL_PATH=/models/all-MiniLM-L6-v2
CAMPUSPILOT_RERANKER_ENABLED=1
CAMPUSPILOT_RERANKER_MODEL_PATH=/models/ms-marco-MiniLM-L6-v2
