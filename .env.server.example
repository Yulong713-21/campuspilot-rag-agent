# CampusPilot public demo. Copy to .env on the server and keep real values out of Git.
CAMPUSPILOT_CORS_ORIGINS=http://43.108.32.225

# Stable first-stage mode: deterministic Planner + catalog BM25.
CAMPUSPILOT_RETRIEVAL_MODE=catalog_bm25
CAMPUSPILOT_VECTOR_SEARCH_ENABLED=0
CAMPUSPILOT_RERANKER_ENABLED=0

# Prepare these paths before changing VECTOR_SEARCH_ENABLED to 1.
CAMPUSPILOT_MILVUS_URI=/app/data/vector/campuspilot-handbook.db
CAMPUSPILOT_MILVUS_COLLECTION=campuspilot_handbook_v2
CAMPUSPILOT_EMBEDDING_BACKEND=sentence-transformer
CAMPUSPILOT_EMBEDDING_MODEL_PATH=/models/all-MiniLM-L6-v2

# OpenAI-compatible model gateway. Keep the real key in server secrets.
CAMPUSPILOT_CLOUD_LLM_ENABLED=1
CAMPUSPILOT_OPENAI_BASE_URL=https://example.com/compatible-mode/v1
CAMPUSPILOT_OPENAI_MODEL=replace-with-model-name
CAMPUSPILOT_OPENAI_API_KEY=replace-with-server-secret
CAMPUSPILOT_OPENAI_TIMEOUT_SECONDS=60
CAMPUSPILOT_OPENAI_MAX_RETRIES=2
CAMPUSPILOT_LOG_LEVEL=INFO

# Public server protection and resource limits.
CAMPUSPILOT_ADMIN_ENABLED=0
CAMPUSPILOT_ADMIN_LOCAL_ONLY=1
CAMPUSPILOT_RATE_LIMIT_PER_MINUTE=30
CAMPUSPILOT_MAX_UPLOAD_BYTES=26214400
CAMPUSPILOT_DEPLOYMENT_PROFILE=lite
