# Copy to .env and fill locally. Never commit a real API key.
CAMPUSPILOT_VECTOR_SEARCH_ENABLED=1
CAMPUSPILOT_MILVUS_URI=http://192.168.150.101:19530
CAMPUSPILOT_MILVUS_COLLECTION=campuspilot_handbook_v1
CAMPUSPILOT_BGE_M3_PATH=D:\agentdev\models\bge-m3

CAMPUSPILOT_LLM_PROVIDER=ollama
CAMPUSPILOT_OLLAMA_URL=http://127.0.0.1:11434
CAMPUSPILOT_OLLAMA_MODEL=qwen3.5:2b-q4_K_M

CAMPUSPILOT_CLOUD_LLM_ENABLED=0
CAMPUSPILOT_OPENAI_API_KEY=
CAMPUSPILOT_OPENAI_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
CAMPUSPILOT_OPENAI_MODEL=qwen-plus
CAMPUSPILOT_OPENAI_TIMEOUT_SECONDS=60

# Optional local administration page: http://127.0.0.1:8010/admin
# Keep disabled on public deployments unless it is protected by a private network.
CAMPUSPILOT_ADMIN_ENABLED=0
CAMPUSPILOT_ADMIN_LOCAL_ONLY=1
CAMPUSPILOT_ADMIN_TOKEN=replace-with-a-random-local-admin-token
CAMPUSPILOT_ENV_FILE=.env
